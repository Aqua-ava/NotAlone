# 系统文件与编辑器本地配置
.DS_Store
.idea/

# 本机环境配置与数据库备份；保留可提交的配置示例
.env
.env.*
!.env.example
*.dump
*.backup
*.sql.tmp

# Python 环境、缓存与构建产物
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.coverage
.pytest_cache/

# 本机调研、历史实验、聊天导出、会话截图、临时资料与模型许可状态
/research/
/experiments/hindsight/
/chat_exports/
.dsh-computer-use/
/model-permits/

# 本机架构资料与任务规格
/architecture/adr/
/architecture/history/
/architecture/drafts/
/.scratch/

# 本机语义检索模型（公开模型，按 scripts/prepare_memory_embedding.mjs 准备）
/.models/

# docs 仅保留操作指南与 Agent 工作规则，其余为本机资料
/docs/*
!/docs/guides/
!/docs/agents/

# 仅供本机构建的完整微信工具源码
/local-tools

# pnpm workspace 安装产物
node_modules/
