# NotAlone 本地环境变量模板。
# 复制为仓库根目录的 .env 并填入真实值；.env 已被 .gitignore 忽略，不得提交或分享。

# DeepSeek 模型凭据：真实模型接入与冒烟测试必需（任务 01 冒烟关单条件）。
NOTALONE_DEEPSEEK_API_KEY=

# 可选：覆盖默认模型名（默认官方 deepseek-flash）。
# NOTALONE_DEEPSEEK_MODEL=

# 可选：API 地址（默认官方 https://api.deepseek.com；仅显式配置时使用其他服务）。
# NOTALONE_DEEPSEEK_BASE_URL=

# OpenCode Go：这两项配套填写，沿用上方 API Key；模型名仅在环境配置中设置。
# NOTALONE_DEEPSEEK_BASE_URL=https://opencode.ai/inference/go/anthropic
# NOTALONE_DEEPSEEK_MODEL=deepseek-v4.1-flash
# 可选输出额度不得超过该模型声明的 384000 tokens。

# 可选：指定自动读取和写回模型配置的本地 .env 路径。
# NOTALONE_ENV_FILE=

# SQLite 位置与身份由 App 的受控 userData 启动配置管理，不使用数据库连接串。
