# NotAlone 本地环境变量模板。
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，不得提交或分享。

# DeepSeek 模型凭据：真实模型接入与冒烟测试必需（任务 01 冒烟关单条件）。
NOTALONE_DEEPSEEK_API_KEY=

# 可选：覆盖默认模型名（默认 deepseek-chat；注意 reasoner 不支持结构化输出）。
# NOTALONE_DEEPSEEK_MODEL=

# 可选：API 地址（默认官方 https://api.deepseek.com/v1；用中转/代理服务时填这里）。
# NOTALONE_DEEPSEEK_BASE_URL=

# PostgreSQL 正式导入库连接串（只连本地或受控环境，不入仓库）。
NOTALONE_DATABASE_URL=

# 受控运行身份：正式导入时由环境注入的 owner UUID。
NOTALONE_OWNER_ID=

# 可选：PostgreSQL 集成测试库（默认 notalone_test；必须以 _test 结尾）。
# NOTALONE_TEST_DATABASE_URL=
