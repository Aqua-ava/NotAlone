# NotAlone 本地环境变量模板。
# 复制为仓库根目录的 .env 并填入真实值；.env 已被 .gitignore 忽略，不得提交或分享。

# DeepSeek 模型凭据：真实模型接入与冒烟测试必需（任务 01 冒烟关单条件）。
NOTALONE_DEEPSEEK_API_KEY=

# 可选：覆盖默认模型名（默认官方 deepseek-flash）。
# NOTALONE_DEEPSEEK_MODEL=

# 可选：API 地址（默认官方 https://api.deepseek.com；仅显式配置时使用其他服务）。
# NOTALONE_DEEPSEEK_BASE_URL=

# PostgreSQL 正式导入库连接串（只连本地或受控环境，不入仓库）。
NOTALONE_DATABASE_URL=

# 受控运行身份：首次初始化后写入；生产环境可由运行环境注入 owner UUID。
NOTALONE_OWNER_ID=

# 可选：指定自动读取和首次初始化写回的本地 .env 路径。
# NOTALONE_ENV_FILE=

# 可选：PostgreSQL 集成测试库（默认 notalone_test；必须以 _test 结尾）。
# NOTALONE_TEST_DATABASE_URL=
