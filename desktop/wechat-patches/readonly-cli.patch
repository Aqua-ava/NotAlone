 )
 
+// 会话表里的 username 就是稳定定位标识，即使它不是 wxid_ 前缀。
+// 精确命中会话身份时先于任何联系人名称解析返回，避免自定义 username
+// 被当作显示名处理，或落到需要 cache refresh 的缓存索引分支。
+func (s *server) exactSessionChatCandidate(query, typeFilter string) (chatCandidate, bool) {
+	db, err := s.openDBNoRefresh("session", "session.db")
+	if err != nil {
+		return chatCandidate{}, false
+	}
+	defer db.Close()
+	rows, err := db.Query(`SELECT username,last_timestamp,sort_timestamp FROM SessionTable
+		WHERE COALESCE(is_hidden,0)=0 AND username = ? LIMIT 1`, query)
+	if err != nil || len(rows) == 0 {
+		return chatCandidate{}, false
+	}
+	row := rows[0]
+	username := rowString(row, "username")
+	displayName := username
+	verified := false
+	if contacts, err := s.openDBNoRefresh("contact", "contact.db"); err == nil {
+		defer contacts.Close()
+		names, err := contacts.Query(`SELECT COALESCE(NULLIF(remark,''),NULLIF(nick_name,''),username) AS display_name, verify_flag FROM contact WHERE username = ? LIMIT 1`, username)
+		if err == nil && len(names) > 0 {
+			if name := rowString(names[0], "display_name"); name != "" {
+				displayName = name
+			}
+			verified = rowInt64(names[0], "verify_flag") != 0
+		}
+	}
+	kind := agentChatType(username, wxkind.ClassifyUsername(username), verified)
+	if !chatTypeAllowed(kind, typeFilter) {
+		return chatCandidate{}, false
+	}
+	return chatCandidate{
+		Username:      username,
+		DisplayName:   displayName,
+		ChatType:      kind,
+		LastTimestamp: rowInt64(row, "last_timestamp"),
+		SortTimestamp: rowInt64(row, "sort_timestamp"),
+		Source:        "session",
+		Match:         "username_exact",
+	}, true
+}
