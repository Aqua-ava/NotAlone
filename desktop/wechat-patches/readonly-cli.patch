@@ -16,6 +59,9 @@ func (s *server) liveChatCandidates(query, typeFilter string, limit int) ([]chat
 	if query == "" {
 		return nil, nil, fmt.Errorf("query/chat is required")
 	}
+	if exact, ok := s.exactSessionChatCandidate(query, typeFilter); ok {
+		return []chatCandidate{exact}, nil, nil
