{
  "name": "notalone-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NotAlone 本机桌面端",
  "main": "dist/main/index.cjs",
  "scripts": {
    "prototype:replies": "node prototype/start.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run dev",
    "test": "npm run typecheck && node scripts/test-safe.mjs",
    "test:polling": "node --test tests/skill-learning/*.test.mjs tests/background-task-polling.test.mjs tests/contact-relationship-overview.test.mjs tests/memory-processing/bridge.test.mjs",
    "test:app": "node scripts/test-app.mjs",
    "test:app:status": "node scripts/test-app.mjs --status",
    "test:pages": "node scripts/test-pages.mjs",
    "test:package": "node scripts/release-check.mjs",
    "prepare:probe": "node scripts/prepare-probe.mjs",
    "package": "node scripts/package.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "dev:status": "node scripts/development-status.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
