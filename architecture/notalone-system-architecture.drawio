<mxfile host="app.diagrams.net" modified="2026-08-16T00:00:00.000Z" agent="Codex" version="31.1.8" type="device" compressed="false">
  <diagram id="overview-clean" name="01-系统总览">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="o0"/>
        <mxCell id="o1" parent="o0"/>
        <mxCell id="otitle" value="NotAlone v1 系统总览｜只看三条主路径：采集、候选回复、长任务" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="o1"><mxGeometry x="40" y="20" width="1700" height="40" as="geometry"/></mxCell>
        <mxCell id="oclient" value="macOS 客户端（用户设备）" style="swimlane;html=1;rounded=0;startSize=34;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;fontSize=15;" vertex="1" parent="o1"><mxGeometry x="40" y="90" width="320" height="840" as="geometry"/></mxCell>
        <mxCell id="oui" value="交互与联系人确认&#xa;登录、设备绑定、联系人绑定&#xa;导入与任务进度、候选查看和编辑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2980b9;align=left;spacingLeft=10;" vertex="1" parent="o1"><mxGeometry x="75" y="150" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="ocapture" value="前台会话采集&#xa;仅微信前台、已绑定且可见会话&#xa;本地 OCR、归属校验、增量去重&#xa;经 API 上报已归属文字" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2980b9;align=left;spacingLeft=10;" vertex="1" parent="o1"><mxGeometry x="75" y="310" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="otemp" value="端侧最小化处理&#xa;OCR 帧默认只在内存中&#xa;未归属临时数据超时清理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;align=left;spacingLeft=10;" vertex="1" parent="o1"><mxGeometry x="75" y="470" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="omanual" value="人工发送边界&#xa;用户选择或修改候选&#xa;用户亲自在聊天 App 发送&#xa;系统不注册发送 Tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontStyle=1;align=center;" vertex="1" parent="o1"><mxGeometry x="75" y="650" width="250" height="115" as="geometry"/></mxCell>

        <mxCell id="ocloud" value="云端模块化单体（同一代码库，不同职责）" style="swimlane;html=1;rounded=0;startSize=34;fillColor=#e9f7ef;strokeColor=#239b56;fontStyle=1;fontSize=15;" vertex="1" parent="o1"><mxGeometry x="410" y="90" width="960" height="840" as="geometry"/></mxCell>
        <mxCell id="ofacade" value="API / 应用层&#xa;鉴权、owner/contact 范围校验、幂等键、事务&#xa;回复入口、创建任务、查询进度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="o1"><mxGeometry x="445" y="145" width="890" height="85" as="geometry"/></mxCell>
        <mxCell id="oguard" value="访问与联系人护栏&#xa;auth_device + contacts&#xa;稳定 owner_id + contact_id&#xa;不按昵称或模型猜测联系人" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;align=left;spacingLeft=10;" vertex="1" parent="o1"><mxGeometry x="445" y="280" width="205" height="120" as="geometry"/></mxCell>
        <mxCell id="oreplylane" value="候选回复路径（同步、数秒级）" style="swimlane;html=1;rounded=0;startSize=30;fillColor=#eef7fc;strokeColor=#2874a6;fontStyle=1;" vertex="1" parent="o1"><mxGeometry x="690" y="270" width="300" height="440" as="geometry"/></mxCell>
        <mxCell id="oreply" value="reply / create_agent&#xa;确定性预检 → 有界 Tool loop&#xa;→ 校验 → 持久化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#2874a6;fontStyle=1;" vertex="1" parent="o1"><mxGeometry x="715" y="330" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="ocontext" value="retrieval + skills&#xa;load_skill + 两个检索 Tool&#xa;runtime 注入联系人范围和预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2874a6;" vertex="1" parent="o1"><mxGeometry x="715" y="470" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="ogateway" value="gateway / ModelPort&#xa;已批准模型 adapter&#xa;字段裁剪、结构化输出、出站台账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#7d3c98;" vertex="1" parent="o1"><mxGeometry x="715" y="595" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="ojobslane" value="资料与长任务路径（异步、可恢复）" style="swimlane;html=1;rounded=0;startSize=30;fillColor=#fff9e6;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="o1"><mxGeometry x="1030" y="270" width="305" height="440" as="geometry"/></mxCell>
        <mxCell id="oingest" value="ingest + memory&#xa;导入解析、规范化、来源追溯&#xa;message、memory_candidate、confirmed_memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b7950b;" vertex="1" parent="o1"><mxGeometry x="1055" y="330" width="255" height="95" as="geometry"/></mxCell>
        <mxCell id="ojobs" value="jobs&#xa;background_task + 固定 step 模板&#xa;租约、重试、幂等、verifying" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="o1"><mxGeometry x="1055" y="470" width="255" height="80" as="geometry"/></mxCell>
        <mxCell id="oworker" value="Worker 独立进程&#xa;领取步骤、调用处理器、写回结果&#xa;只有语义步骤才调用 AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="o1"><mxGeometry x="1055" y="595" width="255" height="80" as="geometry"/></mxCell>
        <mxCell id="oaudit" value="跨路径护栏：确定性范围/风险/引用校验；可观测性记录节点、步骤、重试、版本、引用 ID 和出站数据类别；日志默认不保存完整聊天正文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;align=left;spacingLeft=12;" vertex="1" parent="o1"><mxGeometry x="445" y="770" width="890" height="80" as="geometry"/></mxCell>

        <mxCell id="oinfra" value="权威数据与外部边界" style="swimlane;html=1;rounded=0;startSize=34;fillColor=#f4ecf7;strokeColor=#884ea0;fontStyle=1;fontSize=15;" vertex="1" parent="o1"><mxGeometry x="1420" y="90" width="340" height="840" as="geometry"/></mxCell>
        <mxCell id="opg" value="PostgreSQL 权威业务库&#xa;联系人、来源、消息、记忆、Skill&#xa;回复、任务和步骤&#xa;所有联系人查询先过滤&#xa;owner_id + contact_id" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#884ea0;fontStyle=1;" vertex="1" parent="o1"><mxGeometry x="1450" y="150" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="ocheckpoint" value="LangGraph runtime state / 可选 checkpoint&#xa;启用时只保存最小运行引用&#xa;不是关系记忆或任务事实" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#884ea0;" vertex="1" parent="o1"><mxGeometry x="1450" y="350" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="oobject" value="对象存储（待选型）&#xa;经授权的原始导入文件&#xa;按 owner/contact/source 分层&#xa;加密、保留、级联删除" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#884ea0;" vertex="1" parent="o1"><mxGeometry x="1450" y="490" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="oprovider" value="已批准模型供应商&#xa;生成、抽取、可选 ASR/TTS&#xa;地域、留存、训练使用、删除 SLA&#xa;均须先登记" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#7d3c98;" vertex="1" parent="o1"><mxGeometry x="1450" y="655" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="ofuture" value="未来但非 v1 前提&#xa;队列 / Celery / Temporal&#xa;向量检索 / RAGFlow&#xa;必须保持现有 Port 与领域契约" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;" vertex="1" parent="o1"><mxGeometry x="1450" y="810" width="280" height="75" as="geometry"/></mxCell>

        <mxCell id="oe1" value="请求 / 结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;strokeColor=#2980b9;" edge="1" parent="o1" source="oui" target="ofacade"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2874a6;" edge="1" parent="o1" source="ofacade" target="oreply"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b7950b;" edge="1" parent="o1" source="ofacade" target="oingest"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2874a6;" edge="1" parent="o1" source="oreply" target="ocontext"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7d3c98;" edge="1" parent="o1" source="ocontext" target="ogateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b7950b;" edge="1" parent="o1" source="oingest" target="ojobs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b7950b;" edge="1" parent="o1" source="ojobs" target="oworker"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="reply-clean" name="02-候选回复流程">
    <mxGraphModel dx="1500" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="r0"/>
        <mxCell id="r1" parent="r0"/>
        <mxCell id="rtitle" value="候选回复运行时｜确定性外壳中的 create_agent 有界 Tool Loop" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="r1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="rrequest" value="ReplyRequest&#xa;owner_id + contact_id + current_message&#xa;可选 user_skill_id + 幂等键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="530" y="80" width="410" height="70" as="geometry"/></mxCell>
        <mxCell id="rpre" value="阶段 1｜预检（确定性代码）" style="swimlane;html=1;rounded=0;startSize=28;fillColor=#fef5f4;strokeColor=#c0392b;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="450" y="180" width="570" height="170" as="geometry"/></mxCell>
        <mxCell id="rscope" value="1. validate_scope&#xa;认证、owner/contact、绑定和删除状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;" vertex="1" parent="r1"><mxGeometry x="510" y="225" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="rrisk" value="2. assess_request_risk&#xa;确定性风险类型与生成前核实提醒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;" vertex="1" parent="r1"><mxGeometry x="510" y="285" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="rcontextstage" value="阶段 2｜初始上下文与有界 Agent Loop" style="swimlane;html=1;rounded=0;startSize=28;fillColor=#f7f9e8;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="450" y="380" width="570" height="390" as="geometry"/></mxCell>
        <mxCell id="rselect" value="3. assemble_initial_context&#xa;当前消息、近期对话、常驻卡、Skill 精简目录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;" vertex="1" parent="r1"><mxGeometry x="510" y="425" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="rload" value="4. create_agent 模型决策&#xa;信息足够则输出；否则选择一个已注册只读 Tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daef;strokeColor=#7d3c98;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="510" y="490" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="rplan" value="5. load_skill Tool（可选）&#xa;SkillPort 校验目录、范围和不可变版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;" vertex="1" parent="r1"><mxGeometry x="510" y="555" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="rretrieve" value="6. search_contact_messages Tool（按需）&#xa;runtime 注入 owner_id + contact_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;" vertex="1" parent="r1"><mxGeometry x="510" y="620" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="rassemble" value="7. search_confirmed_memories Tool（按需）&#xa;只返回有效、带来源的已采纳资料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;" vertex="1" parent="r1"><mxGeometry x="510" y="685" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="rgenstage" value="阶段 3｜生成与校验" style="swimlane;html=1;rounded=0;startSize=28;fillColor=#f7f0fb;strokeColor=#7d3c98;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="450" y="800" width="570" height="250" as="geometry"/></mxCell>
        <mxCell id="rgenerate" value="8. structured output&#xa;返回 1-3 条 ReplyCandidates 或澄清需求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daef;strokeColor=#7d3c98;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="510" y="845" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="rvalidate" value="9. validate_agent_output&#xa;候选或澄清需求的 schema、引用与禁止动作检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;" vertex="1" parent="r1"><mxGeometry x="510" y="910" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="rpersist" value="10. persist_trace&#xa;事务幂等写入 reply_request、上下文快照和 reply_candidate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;" vertex="1" parent="r1"><mxGeometry x="510" y="975" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="rhumanstage" value="阶段 4｜返回人工决策" style="swimlane;html=1;rounded=0;startSize=28;fillColor=#fdf2e9;strokeColor=#e67e22;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="450" y="1080" width="570" height="170" as="geometry"/></mxCell>
        <mxCell id="rreturn" value="11. return_result&#xa;返回候选或澄清需求、依据和风险提醒，不含发送动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;" vertex="1" parent="r1"><mxGeometry x="510" y="1125" width="450" height="45" as="geometry"/></mxCell>
        <mxCell id="rmanual" value="用户选择 / 修改 / 拒绝&#xa;用户亲自在外部聊天 App 发送；明确同意后才可保存 style_sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="510" y="1190" width="450" height="45" as="geometry"/></mxCell>

        <mxCell id="rsix" value="六轨上下文&#xa;1 硬规则：隔离、人工发送、高风险&#xa;2 按需加载 reply_skill_version&#xa;3 owner_preference + carry 常驻卡&#xa;4 Tool 检索 message / confirmed_memory&#xa;5 近期对话（最强事实依据）&#xa;6 style_sample（最多 5 条，最弱）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="60" y="185" width="340" height="220" as="geometry"/></mxCell>
        <mxCell id="rports" value="Port 与框架边界&#xa;create_agent：有界模型-Tool 循环&#xa;LangGraph：底层 runtime&#xa;SkillPort：目录和不可变正文&#xa;RetrievalPort：两个检索能力与引用&#xa;ModelPort：已批准模型接口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7d3c98;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="60" y="455" width="340" height="225" as="geometry"/></mxCell>
        <mxCell id="rfailure" value="失败处理不走隐藏降级&#xa;范围不明：要求用户选择联系人&#xa;检索为空：预算内换查询并显式标记&#xa;模型失败：有限重试或已批准模型&#xa;持久化失败：不返回未落库候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="1070" y="245" width="360" height="175" as="geometry"/></mxCell>
        <mxCell id="rstate" value="状态不得混用&#xa;业务事实：PostgreSQL 的 contact/message/memory/reply/skill&#xa;回复运行：create_agent / LangGraph 最小 state&#xa;长任务：PostgreSQL jobs 的 task/step/lease&#xa;runtime state 或 checkpoint 不是业务事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#884ea0;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="1070" y="475" width="360" height="180" as="geometry"/></mxCell>
        <mxCell id="rtool" value="Tool 与硬边界&#xa;v1 allow：load_skill、消息检索、确认记忆检索&#xa;未来 ask：明确授权的外部读取&#xa;deny：切换会话、跨联系人读取、发送消息&#xa;模型 Tool call 不等于获准执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="1070" y="710" width="360" height="175" as="geometry"/></mxCell>
        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="rrequest" target="rscope"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="rscope" target="rrisk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="rrisk" target="rselect"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="rselect" target="rload"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="rload" target="rplan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re6" value="结果返回模型" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b7950b;" edge="1" parent="r1" source="rplan" target="rload"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#239b56;" edge="1" parent="r1" source="rload" target="rretrieve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re8" value="结果返回模型" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#239b56;" edge="1" parent="r1" source="rretrieve" target="rload"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#239b56;" edge="1" parent="r1" source="rload" target="rassemble"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re14" value="结果返回模型" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#239b56;" edge="1" parent="r1" source="rassemble" target="rload"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re15" value="信息足够 / 需要澄清" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7d3c98;" edge="1" parent="r1" source="rload" target="rgenerate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="rgenerate" target="rvalidate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="rvalidate" target="rpersist"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="rpersist" target="rreturn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#e67e22;" edge="1" parent="r1" source="rreturn" target="rmanual"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="jobs-clean" name="03-后台任务与Worker">
    <mxGraphModel dx="2000" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2050" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="j0"/>
        <mxCell id="j1" parent="j0"/>
        <mxCell id="jtitle" value="长任务运行面｜一条直线说明：谁创建、谁记录、谁执行、谁验收" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="j1"><mxGeometry x="40" y="20" width="1900" height="40" as="geometry"/></mxCell>
        <mxCell id="jrequest" value="用户 / API&#xa;导入、删除、重建索引&#xa;鉴权、范围校验、幂等键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;" vertex="1" parent="j1"><mxGeometry x="50" y="210" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="jfactory" value="TaskFactory&#xa;确定性代码创建&#xa;task + 固定步骤模板&#xa;模型不能改步骤或依赖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="j1"><mxGeometry x="320" y="200" width="235" height="120" as="geometry"/></mxCell>
        <mxCell id="jstore" value="PostgreSQL 任务权威状态&#xa;&#xa;background_task&#xa;type / scope / status / progress / retry&#xa;&#xa;background_task_step&#xa;sequence / status / attempt / input-output refs&#xa;worker_id / lease_expires_at / error_type" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#884ea0;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="j1"><mxGeometry x="615" y="155" width="360" height="210" as="geometry"/></mxCell>
        <mxCell id="jworker" value="Worker&#xa;原子领取 pending/retryable 步骤&#xa;写入 worker_id + 短租约&#xa;心跳续租；租约过期可接管" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="j1"><mxGeometry x="1035" y="200" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="jhandler" value="步骤处理器&#xa;解析、规范化、索引、删除、缓存清理&#xa;语义步骤才经 ModelPort 调用 AI&#xa;每个写入均使用业务幂等键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;fontStyle=1;" vertex="1" parent="j1"><mxGeometry x="1355" y="190" width="285" height="140" as="geometry"/></mxCell>
        <mxCell id="jverify" value="确定性验证器&#xa;隔离、来源、数量、索引和删除结果一致&#xa;AI 或 progress=100% 不代表成功" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;fontStyle=1;" vertex="1" parent="j1"><mxGeometry x="1700" y="200" width="255" height="120" as="geometry"/></mxCell>
        <mxCell id="jsuccess" value="verifying → succeeded&#xa;只在验证通过后状态迁移" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;fontStyle=1;" vertex="1" parent="j1"><mxGeometry x="1700" y="390" width="255" height="70" as="geometry"/></mxCell>
        <mxCell id="jsemantic" value="语义步骤的可选能力&#xa;extract_memory、说话人歧义、长历史冲突检查&#xa;Worker 调用 ModelPort → gateway；AI 只返回结构化候选，不领取任务、不改状态、不宣布成功" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#7d3c98;align=left;spacingLeft=12;" vertex="1" parent="j1"><mxGeometry x="1355" y="400" width="285" height="145" as="geometry"/></mxCell>
        <mxCell id="jtemplates" value="固定步骤模板（代码协议）&#xa;import：parse → normalize → extract_memory → index → verify&#xa;delete：mark_deleted → delete_derived → delete_index → clear_cache → verify_not_retrievable&#xa;reindex：select_scope → rebuild_index → verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;align=left;spacingLeft=12;" vertex="1" parent="j1"><mxGeometry x="50" y="650" width="860" height="120" as="geometry"/></mxCell>
        <mxCell id="jstates" value="状态机&#xa;父任务：queued → running → verifying → succeeded；失败或取消按规则退出&#xa;步骤：pending → running → succeeded；失败分 retryable / failed&#xa;进度由模板权重和完成步骤计算，不由模型填写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;align=left;spacingLeft=12;" vertex="1" parent="j1"><mxGeometry x="970" y="650" width="660" height="120" as="geometry"/></mxCell>
        <mxCell id="jboundary" value="使用边界&#xa;使用：长导入、级联删除、重建索引&#xa;不使用：一次候选回复、单个轻量 OCR 增量&#xa;只有并发、动态依赖或跨机可靠性出现可测量瓶颈，才评估队列 / Celery / Temporal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;align=left;spacingLeft=12;" vertex="1" parent="j1"><mxGeometry x="1690" y="625" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="je1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="j1" source="jrequest" target="jfactory"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je2" value="事务创建" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#884ea0;" edge="1" parent="j1" source="jfactory" target="jstore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je3" value="领取 / 写回" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;strokeColor=#b7950b;" edge="1" parent="j1" source="jstore" target="jworker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b7950b;" edge="1" parent="j1" source="jworker" target="jhandler"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je5" value="全部业务步骤成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#c0392b;" edge="1" parent="j1" source="jhandler" target="jverify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je6" value="验证通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#239b56;" edge="1" parent="j1" source="jverify" target="jsuccess"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="data-clean" name="04-核心数据关系">
    <mxGraphModel dx="1900" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="d0"/>
        <mxCell id="d1" parent="d0"/>
        <mxCell id="dtitle" value="核心数据关系｜三条独立链：身份与来源、回复审计、后台任务" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="d1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell>
        <mxCell id="dprovenance" value="A. 身份与来源证据链（所有联系人范围对象先按 owner_id + contact_id 隔离）" style="swimlane;html=1;rounded=0;startSize=30;fillColor=#eefaf3;strokeColor=#239b56;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="40" y="90" width="1850" height="340" as="geometry"/></mxCell>
        <mxCell id="downer" value="owner&#xa;owner_id 第一层隔离键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="75" y="170" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="dpref" value="owner_preference&#xa;跨联系人的全局偏好 / 禁忌" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;" vertex="1" parent="d1"><mxGeometry x="75" y="300" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="dcontact" value="contact&#xa;contact_id 稳定身份&#xa;昵称仅展示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="330" y="160" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="dsource" value="source_document&#xa;一次单联系人导入&#xa;来源定位 / 删除状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;" vertex="1" parent="d1"><mxGeometry x="590" y="160" width="205" height="80" as="geometry"/></mxCell>
        <mxCell id="dbinding" value="conversation_binding&#xa;用户确认的 App / 账号 / 会话绑定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;" vertex="1" parent="d1"><mxGeometry x="590" y="300" width="205" height="65" as="geometry"/></mxCell>
        <mxCell id="dcapture" value="session_capture&#xa;前台 OCR 的最小文本来源&#xa;未归属时不得产出 message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;" vertex="1" parent="d1"><mxGeometry x="850" y="295" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="dmessage" value="message（统一文字模型）&#xa;owner_id + contact_id&#xa;speaker / timestamp / text&#xa;一个权威来源引用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="850" y="155" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="dcandidate" value="memory_candidate&#xa;模型/规则提取 + 证据范围&#xa;pending / confirmed / rejected / invalidated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#7d3c98;" vertex="1" parent="d1"><mxGeometry x="1140" y="155" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="dconfirmed" value="confirmed_memory&#xa;candidate + 多证据&#xa;auto / manual + 可撤销&#xa;分类 / 有效期 / carry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#7d3c98;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="1460" y="150" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="daudit" value="B. 回复审计链（每次实际使用的上下文和 Skill 版本均可回看）" style="swimlane;html=1;rounded=0;startSize=30;fillColor=#eef7fc;strokeColor=#2874a6;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="40" y="470" width="1850" height="190" as="geometry"/></mxCell>
        <mxCell id="dskill" value="reply_skill&#xa;name / description / when_to_use&#xa;owner 全局或 contact 范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;" vertex="1" parent="d1"><mxGeometry x="100" y="530" width="245" height="75" as="geometry"/></mxCell>
        <mxCell id="dskillver" value="reply_skill_version&#xa;不可变正文&#xa;v1 allowed_tools = 空" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;" vertex="1" parent="d1"><mxGeometry x="430" y="530" width="230" height="75" as="geometry"/></mxCell>
        <mxCell id="drequest" value="reply_request&#xa;owner/contact/current_message&#xa;skill_version_id / graph_run_id&#xa;内嵌 retrieved_context 快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="745" y="520" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="dreplycand" value="reply_candidate&#xa;候选正文、依据引用、风险说明&#xa;绝不自动发送" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="1110" y="530" width="245" height="75" as="geometry"/></mxCell>
        <mxCell id="dstyle" value="style_sample&#xa;仅用户明确同意保存&#xa;选择候选不等于长期沉淀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;" vertex="1" parent="d1"><mxGeometry x="1440" y="530" width="245" height="75" as="geometry"/></mxCell>
        <mxCell id="djobs" value="C. 后台任务链（仅用于长导入、删除和重建）" style="swimlane;html=1;rounded=0;startSize=30;fillColor=#fff9e6;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="40" y="700" width="1850" height="180" as="geometry"/></mxCell>
        <mxCell id="dtask" value="background_task&#xa;type / scope / status / progress&#xa;queued / running / verifying / succeeded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="140" y="760" width="310" height="75" as="geometry"/></mxCell>
        <mxCell id="dstep" value="background_task_step&#xa;step_type / sequence / status / attempt&#xa;worker_id / lease / input-output refs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="570" y="755" width="330" height="85" as="geometry"/></mxCell>
        <mxCell id="doutput" value="派生业务对象&#xa;message / memory_candidate / index / cache&#xa;全部保留来源与删除入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;" vertex="1" parent="d1"><mxGeometry x="1020" y="760" width="310" height="75" as="geometry"/></mxCell>
        <mxCell id="dnote" value="删除与隐私的详细流程见下一页；不要把流程规则误画成 ER 关系。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;" vertex="1" parent="d1"><mxGeometry x="1450" y="765" width="310" height="65" as="geometry"/></mxCell>
        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="downer" target="dcontact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="downer" target="dpref"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="dcontact" target="dsource"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="dcontact" target="dbinding"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de5" value="权威来源" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="dsource" target="dmessage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de6" value="已归属才产生" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="dbinding" target="dcapture"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="dcapture" target="dmessage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de8" value="证据" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="dmessage" target="dcandidate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de9" value="自动/手动采纳" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="dcandidate" target="dconfirmed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="dskill" target="dskillver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de11" value="本次版本" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="dskillver" target="drequest"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="drequest" target="dreplycand"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de13" value="明确同意" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="d1" source="dreplycand" target="dstyle"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="dtask" target="dstep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de15" value="处理结果引用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="d1" source="dstep" target="doutput"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="privacy-delete" name="05-删除与隐私">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="p0"/>
        <mxCell id="p1" parent="p0"/>
        <mxCell id="ptitle" value="删除与隐私｜删除是一条可验证的后台流程，不是数据关系线" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="p1"><mxGeometry x="40" y="20" width="1700" height="40" as="geometry"/></mxCell>
        <mxCell id="pflow" value="来源级联删除主线（每一步均记录在 background_task_step）" style="swimlane;html=1;rounded=0;startSize=30;fillColor=#fef5f4;strokeColor=#c0392b;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="40" y="100" width="1770" height="260" as="geometry"/></mxCell>
        <mxCell id="pstart" value="用户删除&#xa;账户 / 联系人 / 来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="80" y="185" width="180" height="75" as="geometry"/></mxCell>
        <mxCell id="ptask" value="创建 delete task&#xa;scope 限定 account/contact/source&#xa;幂等、可重试、可查看进度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="330" y="175" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="pmark" value="标记与定位来源&#xa;source_document 或 session_capture&#xa;不能跨 owner/contact 边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;" vertex="1" parent="p1"><mxGeometry x="620" y="175" width="225" height="95" as="geometry"/></mxCell>
        <mxCell id="pderived" value="删除派生资料&#xa;message、仅有该来源的候选和记忆证据&#xa;索引、缓存、任务产物、对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;" vertex="1" parent="p1"><mxGeometry x="915" y="165" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="pverify" value="verify_not_retrievable&#xa;确定性检查：删除后不可检索&#xa;失败可续跑，不能静默完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="1255" y="175" width="235" height="95" as="geometry"/></mxCell>
        <mxCell id="psuccess" value="verifying → succeeded&#xa;展示结果或明确失败原因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;fontStyle=1;" vertex="1" parent="p1"><mxGeometry x="1560" y="185" width="205" height="75" as="geometry"/></mxCell>
        <mxCell id="pprivacy" value="隐私硬边界&#xa;• 所有联系人查询先过滤 owner_id + contact_id&#xa;• 不允许按昵称跨联系人搜资料后再选择&#xa;• 模型只接收后端裁剪的小量上下文，不持有数据库凭据&#xa;• 前台会话原始视觉帧默认不上传、不持久化&#xa;• 日志默认只保存引用 ID 与运行元数据，不保存完整聊天正文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;align=left;spacingLeft=14;" vertex="1" parent="p1"><mxGeometry x="80" y="470" width="720" height="210" as="geometry"/></mxCell>
        <mxCell id="pmanual" value="用户主动保留的唯一例外&#xa;若要保留某条已确认资料，用户必须执行“另存为手动资料”。&#xa;该操作创建一条与原来源无关的新 confirmed_memory，清空来源和候选链；之后原来源删除不再影响它。&#xa;&#xa;系统不能默认保留、推测保留或把一次回复策略升级为长期偏好。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7fc;strokeColor=#2874a6;align=left;spacingLeft=14;" vertex="1" parent="p1"><mxGeometry x="860" y="470" width="600" height="210" as="geometry"/></mxCell>
        <mxCell id="pout" value="当前明确不做&#xa;自动发送外部消息&#xa;后台读取所有聊天、切换会话或滚动历史&#xa;模型自行扩大联系人范围&#xa;以模型计划或 checkpoint 代替业务删除记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;align=left;spacingLeft=14;" vertex="1" parent="p1"><mxGeometry x="1520" y="470" width="280" height="210" as="geometry"/></mxCell>
        <mxCell id="pe1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="p1" source="pstart" target="ptask"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#c0392b;" edge="1" parent="p1" source="ptask" target="pmark"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#c0392b;" edge="1" parent="p1" source="pmark" target="pderived"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#c0392b;" edge="1" parent="p1" source="pderived" target="pverify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#239b56;" edge="1" parent="p1" source="pverify" target="psuccess"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
