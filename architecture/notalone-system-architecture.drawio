<mxfile host="app.diagrams.net" modified="2026-08-12T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="system-overview" name="01-系统总览">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="NotAlone v1 整体架构｜云端模块化单体 + macOS 前台授权采集 + 人工发送" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1650" height="40" as="geometry"/></mxCell>
        <mxCell id="boundary-client" value="macOS 客户端（用户设备）" style="swimlane;html=1;rounded=0;startSize=34;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="300" height="830" as="geometry"/></mxCell>
        <mxCell id="client-ui" value="交互与联系人确认&#xa;• 登录 / 设备绑定&#xa;• 首次会话绑定&#xa;• 导入与任务进度&#xa;• 候选查看、编辑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2980b9;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="65" y="140" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="sync" value="sync_adapter&#xa;• 仅微信前台、可见会话&#xa;• ScreenCaptureKit 变化检测&#xa;• 本地 Vision OCR&#xa;• 归属校验 / 增量去重&#xa;• 原始帧默认只驻留内存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2980b9;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="65" y="300" width="250" height="145" as="geometry"/></mxCell>
        <mxCell id="input-adapters" value="输入 / 输出适配器&#xa;截图 → OCR → 文字&#xa;语音 → ASR → 文字&#xa;候选文字 → 可选 TTS 预览" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2980b9;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="65" y="480" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="manual" value="人工控制边界&#xa;用户选择 / 修改候选&#xa;用户亲自在微信发送&#xa;&#xa;系统无发送 Tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="65" y="625" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="temp" value="端侧临时数据&#xa;未归属 capture / OCR 帧 / 缓存&#xa;超时、停用或解绑时清理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="65" y="780" width="250" height="90" as="geometry"/></mxCell>

        <mxCell id="boundary-cloud" value="云端模块化单体（同一代码库，清晰模块边界）" style="swimlane;html=1;rounded=0;startSize=34;fillColor=#e9f7ef;strokeColor=#239b56;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="950" height="830" as="geometry"/></mxCell>
        <mxCell id="api" value="API / 应用层&#xa;认证、范围校验、幂等键、事务&#xa;创建任务 / 查询进度 / 回复入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="auth" value="auth_device&#xa;owner 身份 / 设备令牌&#xa;注册、撤销、解绑清理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;" vertex="1" parent="1"><mxGeometry x="760" y="130" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="contacts" value="contacts&#xa;contact&#xa;conversation_binding&#xa;owner_id + contact_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;" vertex="1" parent="1"><mxGeometry x="1030" y="130" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="ingest" value="ingest&#xa;文件解析 / 规范化&#xa;来源定位 / 消息去重" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;" vertex="1" parent="1"><mxGeometry x="420" y="265" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="jobs" value="jobs&#xa;background_task 状态机&#xa;固定 step 模板 / 租约 / 幂等&#xa;verifying 最终检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="255" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="worker" value="Worker 独立进程&#xa;领取 background_task_step&#xa;执行 handler / 更新状态&#xa;崩溃后租约接管" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="255" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="memory" value="memory&#xa;source / message&#xa;memory_candidate&#xa;confirmed_memory / style_sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;" vertex="1" parent="1"><mxGeometry x="420" y="415" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="retrieval" value="retrieval / RetrievalPort&#xa;PostgreSQL 结构化 + 全文检索&#xa;联系人过滤 / 排序 / 预算 / 引用&#xa;量化漏检后才评估向量/RAGFlow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;" vertex="1" parent="1"><mxGeometry x="710" y="415" width="290" height="115" as="geometry"/></mxCell>
        <mxCell id="skills" value="skills / SkillPort&#xa;目录摘要两级加载&#xa;不可变 reply_skill_version&#xa;v1 最多选择一个" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;" vertex="1" parent="1"><mxGeometry x="1040" y="415" width="240" height="115" as="geometry"/></mxCell>
        <mxCell id="reply" value="reply / LangGraph&#xa;唯一候选回复编排器&#xa;范围 → 风险 → Skill → 检索&#xa;→ 生成 → 校验 → 持久化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6eaf8;strokeColor=#2874a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="575" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="gateway" value="gateway / ModelPort&#xa;LangChain 或供应商 adapter&#xa;结构化输出 / 字段裁剪&#xa;出站台账 / 供应商策略" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#7d3c98;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="575" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="risk" value="确定性规则与校验&#xa;联系人权限 / 高风险提醒&#xa;schema / 引用 / 禁止动作&#xa;AI 不控制业务状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="575" width="190" height="125" as="geometry"/></mxCell>
        <mxCell id="observability" value="可观测性：节点/步骤、耗时、重试、错误类型、模型/检索器版本、引用 ID、出站数据类别；日志默认不保存完整聊天正文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;" vertex="1" parent="1"><mxGeometry x="420" y="755" width="860" height="70" as="geometry"/></mxCell>

        <mxCell id="boundary-infra" value="基础设施与外部服务" style="swimlane;html=1;rounded=0;startSize=34;fillColor=#f4ecf7;strokeColor=#884ea0;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1370" y="80" width="360" height="830" as="geometry"/></mxCell>
        <mxCell id="postgres" value="PostgreSQL 权威业务库&#xa;owner / contact / binding&#xa;source / message / memory&#xa;reply / skill / task / step&#xa;所有范围查询：owner_id + contact_id" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#884ea0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1410" y="140" width="280" height="145" as="geometry"/></mxCell>
        <mxCell id="checkpoint" value="LangGraph checkpoint store&#xa;仅最小运行引用 / current_node&#xa;不是关系记忆或任务事实" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#884ea0;" vertex="1" parent="1"><mxGeometry x="1410" y="330" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="objectstore" value="对象存储（待选型）&#xa;经授权的原始导入文件&#xa;owner/contact/source 分层&#xa;加密、保留与级联删除" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#884ea0;" vertex="1" parent="1"><mxGeometry x="1410" y="480" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="provider" value="已批准模型供应商&#xa;生成 / 抽取 / 可选 ASR/TTS&#xa;发送字段、地域、留存、训练使用、删除 SLA 必须登记" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#884ea0;" vertex="1" parent="1"><mxGeometry x="1410" y="645" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="future" value="未来可替换基础设施（非 v1 前提）&#xa;队列 / Celery / Temporal&#xa;RAGFlow / 向量检索&#xa;必须保持 Port 与领域契约" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;" vertex="1" parent="1"><mxGeometry x="1410" y="805" width="280" height="70" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2980b9;endArrow=block;" edge="1" parent="1" source="client-ui" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="已归属规范化文字" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2980b9;endArrow=block;" edge="1" parent="1" source="sync" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#239b56;endArrow=block;" edge="1" parent="1" source="api" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#239b56;endArrow=block;" edge="1" parent="1" source="api" target="contacts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="导入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#239b56;endArrow=block;" edge="1" parent="1" source="api" target="ingest"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="创建长任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b7950b;endArrow=block;" edge="1" parent="1" source="api" target="jobs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="领取步骤" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b7950b;endArrow=block;" edge="1" parent="1" source="jobs" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#239b56;endArrow=block;" edge="1" parent="1" source="ingest" target="memory"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2874a6;endArrow=block;" edge="1" parent="1" source="api" target="reply"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2874a6;endArrow=block;" edge="1" parent="1" source="reply" target="retrieval"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2874a6;endArrow=block;" edge="1" parent="1" source="reply" target="skills"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="ModelPort" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d3c98;endArrow=block;" edge="1" parent="1" source="reply" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="语义步骤" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d3c98;endArrow=block;" edge="1" parent="1" source="worker" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c0392b;endArrow=block;" edge="1" parent="1" source="reply" target="risk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="候选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2874a6;endArrow=block;" edge="1" parent="1" source="reply" target="client-ui"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#e67e22;endArrow=block;" edge="1" parent="1" source="client-ui" target="manual"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="业务读写" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#884ea0;endArrow=block;" edge="1" parent="1" source="memory" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="任务/步骤" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#884ea0;endArrow=block;" edge="1" parent="1" source="jobs" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="运行恢复" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#884ea0;endArrow=block;" edge="1" parent="1" source="reply" target="checkpoint"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#884ea0;endArrow=block;" edge="1" parent="1" source="ingest" target="objectstore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" value="裁剪后的字段" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d3c98;endArrow=block;" edge="1" parent="1" source="gateway" target="provider"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="reply-workflow" name="02-候选回复流程">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="r0"/>
        <mxCell id="r1" parent="r0"/>
        <mxCell id="rtitle" value="候选回复运行时｜LangGraph 只编排，LangChain 只适配模型与 Tool" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="r1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell>
        <mxCell id="req" value="ReplyRequest&#xa;owner_id + contact_id&#xa;current_message&#xa;可选 user_skill_id / 幂等键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="40" y="100" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="n1" value="1 validate_scope&#xa;身份、联系人、绑定、删除状态&#xa;确定性代码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;" vertex="1" parent="r1"><mxGeometry x="310" y="100" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="n2" value="2 assess_request_risk&#xa;高风险类型与核实提醒&#xa;确定性代码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;" vertex="1" parent="r1"><mxGeometry x="580" y="100" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="n3" value="3 select_skill&#xa;目录：name + description + when_to_use&#xa;最多一个 skill/version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;" vertex="1" parent="r1"><mxGeometry x="850" y="100" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="n4" value="4 load_skill&#xa;SkillPort 校验范围与版本&#xa;加载不可变 inline 正文&#xa;不是模型 Tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;" vertex="1" parent="r1"><mxGeometry x="1150" y="100" width="240" height="105" as="geometry"/></mxCell>
        <mxCell id="n5" value="5 build_retrieval_plan&#xa;结构化关键词、时间、类型、limit&#xa;模型可建议，代码校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daef;strokeColor=#7d3c98;" vertex="1" parent="r1"><mxGeometry x="1440" y="100" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="n6" value="6 retrieve_context&#xa;RetrievalPort&#xa;先 owner_id + contact_id 过滤&#xa;返回命中、分数、原因、引用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;" vertex="1" parent="r1"><mxGeometry x="1740" y="100" width="230" height="105" as="geometry"/></mxCell>
        <mxCell id="n7" value="7 assemble_context&#xa;按六轨优先级与 token 预算截断&#xa;确定性代码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;" vertex="1" parent="r1"><mxGeometry x="1740" y="300" width="230" height="105" as="geometry"/></mxCell>
        <mxCell id="n8" value="8 generate_candidates&#xa;ModelPort → gateway&#xa;输出 1–3 条结构化候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daef;strokeColor=#7d3c98;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="1440" y="300" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="n9" value="9 validate_candidates&#xa;schema / 引用 / 禁止动作&#xa;风险提示 / 不允许发送&#xa;确定性代码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;" vertex="1" parent="r1"><mxGeometry x="1150" y="300" width="240" height="105" as="geometry"/></mxCell>
        <mxCell id="n10" value="10 persist_trace&#xa;reply_request + retrieved_context&#xa;reply_candidate + 模型元数据&#xa;事务 / 幂等写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;" vertex="1" parent="r1"><mxGeometry x="850" y="300" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="n11" value="11 return_candidates&#xa;候选正文、依据引用、风险提醒&#xa;不包含发送动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="580" y="300" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="user" value="用户选择 / 修改 / 拒绝&#xa;用户亲自在聊天 App 发送&#xa;明确同意后才保存 style_sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="310" y="300" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="failed" value="失败出口&#xa;范围不明：要求用户选择&#xa;检索为空：有界放宽并标记&#xa;模型失败：有限重试&#xa;持久化失败：不返回候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;" vertex="1" parent="r1"><mxGeometry x="40" y="285" width="220" height="135" as="geometry"/></mxCell>
        <mxCell id="six" value="六轨上下文（从强到弱）&#xa;1 硬规则：隔离、人工发送、高风险&#xa;2 本次 reply_skill_version&#xa;3 owner_preference + 联系人 carry 卡&#xa;4 按需检索 message / confirmed_memory&#xa;5 近期对话（最强事实依据）&#xa;6 已采纳 style_sample（最多 5 条）&#xa;&#xa;冲突：当前明确要求与近期对话优先；Skill 只指导方式，不改变事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="40" y="520" width="500" height="230" as="geometry"/></mxCell>
        <mxCell id="ports" value="Port 与框架边界&#xa;&#xa;SkillPort：目录与不可变正文，不执行 Tool&#xa;RetrievalPort：结构化/全文检索、引用、删除、重建&#xa;ModelPort：结构化模型调用接口&#xa;LangChain adapter：供应商 SDK、结构化输出、未来 Tool 适配&#xa;LangGraph：只保存本次图运行状态和条件边&#xa;&#xa;领域对象不导入 LangGraph / LangChain 类型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7d3c98;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="590" y="520" width="490" height="230" as="geometry"/></mxCell>
        <mxCell id="state" value="三类状态严格分开&#xa;&#xa;业务事实（PostgreSQL）&#xa;contact / message / memory / reply / skill&#xa;&#xa;回复运行（checkpoint store）&#xa;graph_run_id / current_node / 最小引用 / retry&#xa;&#xa;后台工作（PostgreSQL jobs）&#xa;background_task / background_task_step / lease&#xa;&#xa;checkpoint 与 Todo 都不能成为业务事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#884ea0;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="1130" y="520" width="400" height="230" as="geometry"/></mxCell>
        <mxCell id="perm" value="Tool Permission（未来）&#xa;&#xa;allow：当前时间、联系人内只读检索&#xa;ask：授权日历、外部关系上下文&#xa;deny：切换会话、跨联系人读取、发送消息&#xa;&#xa;模型提出 Tool call ≠ 获准执行&#xa;应用层校验参数、范围与出站字段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;align=left;spacingLeft=12;" vertex="1" parent="r1"><mxGeometry x="1580" y="520" width="390" height="230" as="geometry"/></mxCell>
        <mxCell id="rc1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="req" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="r1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#e67e22;" edge="1" parent="r1" source="n11" target="user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc13" value="校验失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#c0392b;" edge="1" parent="r1" source="n1" target="failed"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="background-jobs" name="03-后台任务与Worker">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="j0"/>
        <mxCell id="j1" parent="j0"/>
        <mxCell id="jtitle" value="长任务运行面｜background_task 是整项工作，background_task_step 是持久化步骤，Worker 是执行进程" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="j1"><mxGeometry x="40" y="20" width="1650" height="40" as="geometry"/></mxCell>
        <mxCell id="juser" value="用户动作&#xa;导入 / 删除 / 重建索引" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;" vertex="1" parent="j1"><mxGeometry x="50" y="100" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="japi" value="API&#xa;鉴权与 owner/contact 范围校验&#xa;生成 task_id / 幂等键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;" vertex="1" parent="j1"><mxGeometry x="320" y="95" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="jtemplate" value="jobs TaskFactory（确定性代码）&#xa;按 type 创建固定步骤模板&#xa;模型不能改步骤和依赖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="j1"><mxGeometry x="650" y="95" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="jdb" value="PostgreSQL：任务权威状态&#xa;&#xa;background_task&#xa;id / owner_id / contact_id / type / scope&#xa;status / progress / error / retry / timestamps&#xa;&#xa;background_task_step&#xa;task_id / step_type / sequence / status&#xa;attempt / worker_id / lease_expires_at&#xa;input_refs / output_refs / error_type" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#884ea0;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="j1"><mxGeometry x="1010" y="75" width="410" height="235" as="geometry"/></mxCell>
        <mxCell id="poll" value="Worker 循环&#xa;1 原子领取 pending/retryable 步骤&#xa;2 写 worker_id + 短租约&#xa;3 执行 handler&#xa;4 原子写回状态与业务引用&#xa;5 心跳续租；崩溃后允许接管" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="j1"><mxGeometry x="1480" y="85" width="270" height="175" as="geometry"/></mxCell>
        <mxCell id="handlers" value="步骤处理器（普通 Python）" style="swimlane;html=1;rounded=0;startSize=34;fillColor=#f4f6f7;strokeColor=#7f8c8d;fontStyle=1;" vertex="1" parent="j1"><mxGeometry x="50" y="370" width="1060" height="300" as="geometry"/></mxCell>
        <mxCell id="det" value="确定性处理器&#xa;parse_file&#xa;normalize_messages&#xa;build_index&#xa;delete_by_source&#xa;clear_cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;" vertex="1" parent="j1"><mxGeometry x="90" y="435" width="250" height="155" as="geometry"/></mxCell>
        <mxCell id="semantic" value="语义处理器&#xa;extract_memory&#xa;speaker_disambiguation（必要时）&#xa;conflict_check（必要时）&#xa;&#xa;只产出结构化候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#7d3c98;" vertex="1" parent="j1"><mxGeometry x="400" y="435" width="270" height="155" as="geometry"/></mxCell>
        <mxCell id="jgateway" value="ModelPort → gateway&#xa;LangChain / 供应商 adapter&#xa;schema + 出站字段裁剪&#xa;AI 无状态迁移权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#7d3c98;fontStyle=1;" vertex="1" parent="j1"><mxGeometry x="730" y="435" width="270" height="155" as="geometry"/></mxCell>
        <mxCell id="verify" value="确定性最终验证器&#xa;• owner/contact 隔离正确&#xa;• 来源与派生记录可追溯&#xa;• 数量与索引一致&#xa;• 删除后不可再检索&#xa;• 无重复副作用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="j1"><mxGeometry x="1170" y="395" width="300" height="180" as="geometry"/></mxCell>
        <mxCell id="success" value="verifying → succeeded&#xa;只有验证器可以通过状态机完成&#xa;AI 或 progress=100% 均不代表成功" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;fontStyle=1;" vertex="1" parent="j1"><mxGeometry x="1530" y="410" width="230" height="140" as="geometry"/></mxCell>
        <mxCell id="importtpl" value="import 固定模板&#xa;parse → normalize → extract_memory → index → verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2980b9;" vertex="1" parent="j1"><mxGeometry x="50" y="750" width="490" height="80" as="geometry"/></mxCell>
        <mxCell id="deletetpl" value="delete 固定模板&#xa;mark_deleted → delete_derived → delete_index → clear_cache → verify_not_retrievable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;" vertex="1" parent="j1"><mxGeometry x="600" y="750" width="570" height="80" as="geometry"/></mxCell>
        <mxCell id="reindextpl" value="reindex 固定模板&#xa;select_scope → rebuild_index → verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7d3c98;" vertex="1" parent="j1"><mxGeometry x="1230" y="750" width="530" height="80" as="geometry"/></mxCell>
        <mxCell id="states" value="父任务：queued → running → verifying → succeeded；任何阶段可按规则进入 failed/cancelled&#xa;步骤：pending → running → succeeded；失败分 retryable / failed&#xa;进度由模板权重和已完成步骤计算，不由模型填写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;fontStyle=1;" vertex="1" parent="j1"><mxGeometry x="50" y="890" width="820" height="100" as="geometry"/></mxCell>
        <mxCell id="when" value="使用边界&#xa;使用：长导入、级联删除、重建索引&#xa;不用：一次候选回复、单个轻量 OCR 增量&#xa;升级框架条件：并发、动态依赖、跨机可靠性出现可测量瓶颈" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;align=left;spacingLeft=12;" vertex="1" parent="j1"><mxGeometry x="930" y="880" width="830" height="120" as="geometry"/></mxCell>
        <mxCell id="je1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="j1" source="juser" target="japi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="j1" source="japi" target="jtemplate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je3" value="事务创建" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#884ea0;" edge="1" parent="j1" source="jtemplate" target="jdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je4" value="领取 / 写回" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;strokeColor=#b7950b;" edge="1" parent="j1" source="jdb" target="poll"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je5" value="dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b7950b;" edge="1" parent="j1" source="poll" target="det"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b7950b;" edge="1" parent="j1" source="poll" target="semantic"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je7" value="需要语义时" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7d3c98;" edge="1" parent="j1" source="semantic" target="jgateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je8" value="全部业务步骤成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#c0392b;" edge="1" parent="j1" source="poll" target="verify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je9" value="验证通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#239b56;" edge="1" parent="j1" source="verify" target="success"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="data-model" name="04-核心数据与删除">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="d0"/>
        <mxCell id="d1" parent="d0"/>
        <mxCell id="dtitle" value="核心数据关系｜PostgreSQL 是权威库；所有联系人数据按 owner_id + contact_id 隔离并保留来源" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="d1"><mxGeometry x="40" y="20" width="1750" height="40" as="geometry"/></mxCell>
        <mxCell id="owner" value="owner&#xa;owner_id（第一层隔离键）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="60" y="100" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="pref" value="owner_preference&#xa;跨联系人全局偏好 / 禁忌" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;" vertex="1" parent="d1"><mxGeometry x="60" y="220" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="contact" value="contact&#xa;contact_id（稳定身份）&#xa;昵称仅展示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="350" y="100" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="binding" value="conversation_binding&#xa;用户确认的 App / 账号 / 会话绑定&#xa;绑定状态 / 最近验证时间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;" vertex="1" parent="d1"><mxGeometry x="350" y="230" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="source" value="source_document&#xa;一次单联系人导入&#xa;来源定位 / 删除状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="700" y="90" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="capture" value="session_capture&#xa;前台 OCR 最小文本来源&#xa;live / user_backfill / continuity&#xa;未归属临时态不得产出 message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="700" y="230" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="message" value="message（统一文字模型）&#xa;owner_id + contact_id&#xa;speaker / timestamp / text&#xa;一个权威来源引用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#239b56;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="1060" y="130" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="candidate" value="memory_candidate&#xa;模型/规则提取 + 证据范围&#xa;pending / confirmed / rejected / invalidated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#7d3c98;" vertex="1" parent="d1"><mxGeometry x="1410" y="100" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="confirmed" value="confirmed_memory&#xa;source_candidate_id + 多证据&#xa;auto / manual + 可撤销&#xa;分类 / 有效期 / carry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#7d3c98;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="1410" y="260" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="skill" value="reply_skill&#xa;name / description / when_to_use&#xa;owner 全局或 contact 范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;" vertex="1" parent="d1"><mxGeometry x="60" y="440" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="skillver" value="reply_skill_version（不可变）&#xa;目标 / 步骤 / 禁忌 / 示例&#xa;v1 allowed_tools = 空" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;" vertex="1" parent="d1"><mxGeometry x="390" y="440" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="request" value="reply_request&#xa;固定 owner/contact/current_message&#xa;skill_version_id / graph_run_id&#xa;内嵌 retrieved_context 快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="750" y="430" width="290" height="110" as="geometry"/></mxCell>
        <mxCell id="retrieved" value="retrieved_context（内嵌）&#xa;检索条件 / 预算 / 引用列表&#xa;分数 / 入选原因 / 降级状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2980b9;dashed=1;" vertex="1" parent="d1"><mxGeometry x="750" y="590" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="replycand" value="reply_candidate&#xa;候选正文 / 依据引用 / 风险说明&#xa;绝不自动发送" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2980b9;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="1130" y="440" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="style" value="style_sample&#xa;仅用户明确同意保存&#xa;普通候选或选择动作不自动沉淀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#239b56;" vertex="1" parent="d1"><mxGeometry x="1480" y="440" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="task" value="background_task&#xa;type / scope / status / progress&#xa;queued/running/verifying/succeeded/failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="60" y="750" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="step" value="background_task_step&#xa;step_type / sequence / status / attempt&#xa;worker_id / lease_expires_at&#xa;input_refs / output_refs / error_type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf3cf;strokeColor=#b7950b;fontStyle=1;" vertex="1" parent="d1"><mxGeometry x="450" y="740" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="deletion" value="来源级联删除规则&#xa;1 标记来源删除&#xa;2 删除其 message 与索引/缓存&#xa;3 移除 candidate 证据&#xa;4 confirmed_memory 无剩余证据则删除&#xa;5 verify_not_retrievable 后任务成功&#xa;&#xa;保留内容的唯一例外：用户主动“另存为手动资料”，创建与原来源无关的新记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="d1"><mxGeometry x="900" y="750" width="500" height="190" as="geometry"/></mxCell>
        <mxCell id="isolation" value="查询与隐私硬约束&#xa;• 每次先过滤 owner_id + contact_id，再检索/排序&#xa;• 不按昵称跨联系人搜索后再选择&#xa;• 模型只看到后端裁剪的小量上下文，不持有数据库凭据&#xa;• 原始视觉帧默认不上传、不持久化&#xa;• 日志只记引用 ID 与元数据，不默认记完整聊天正文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f7;strokeColor=#7f8c8d;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="d1"><mxGeometry x="1470" y="720" width="360" height="220" as="geometry"/></mxCell>
        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="d1" source="owner" target="contact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="d1" source="owner" target="pref"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="d1" source="contact" target="binding"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="d1" source="contact" target="source"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="d1" source="binding" target="capture"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de6" value="唯一来源" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="d1" source="source" target="message"><mxGeometry relative="1" as="geometry"/></mxCell>
