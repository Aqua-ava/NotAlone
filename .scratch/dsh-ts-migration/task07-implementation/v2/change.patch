+/** 原探索表的单owner事务writer；不获取模型许可，不保存DSH会话。 */
+import {SkillFiles} from './skill-files.ts';
+import {createReplySkillGuards} from './reply-skill-guards.ts';
+import {createReplyAssistantGuards} from './reply-assistant-factory.ts';
+import {randomUUID,createHash} from 'node:crypto';
+import type {Client} from 'pg';
+import {pythonISO} from './contact-overview-time.ts';
+import {canonicalJSON} from './contact-overview-evidence.ts';
+import {inputRows,generationDependencies} from './reply-assistant-erasure.ts';
+import {requireDependencies,requireGenerationMemoryDependencies,requireReplySourcesCurrent} from './reply-source-guards.ts';
+import {readContextMessages} from './reply-context-read.ts';
+import {ExplorationEvidence} from './exploration-evidence.ts';
+import {ExplorationStale,ExplorationExpired,ExplorationError,ExplorationInProgress,parseExplorationInput,hasConfirmedIntent,isUUID,type ExplorationScope,type ExplorationInput,type ExplorationTask,type ExplorationOpen,type ExplorationSkillSelection,type ExplorationResult,type ExplorationReadPurpose,type ExplorationCompletedInput,type EvidenceSnapshot} from './exploration-contract.ts';
+type Row=Record<string,any>;
+export interface ExplorationStoreGuards {
+ active_binding(client:Client,scope:ExplorationScope):Promise<string>;
+ require_current_input(client:Client,scope:ExplorationScope,session_id:string,input_version_id:string):Promise<void>;
+ record_discussion_input(client:Client,scope:ExplorationScope,session_id:string,content:ExplorationInput,expected:string|null,dependencies:string[]):Promise<string>;
+ require_skill(client:Client,scope:ExplorationScope,revision:number,version_id:string|null,scene?:string):Promise<void>;
+}
+export interface ExplorationStoreOptions {transaction<T>(fn:(client:Client)=>Promise<T>):Promise<T>;evidence:ExplorationEvidence;skills_root?:string;guards?:Partial<ExplorationStoreGuards>}
+const stale=():never=>{throw new ExplorationStale();};
+const equal=(a:unknown,b:unknown)=>canonicalJSON(a)===canonicalJSON(b);
+export function operationDigest(request:ExplorationOpen):string {
+ const content={...parseExplorationInput(request.content)} as Row;delete content.confirmed_intent;
+ const payload={content,session_id:request.session_id,expected_input_version_id:request.expected_input_version_id??null,previous_id:request.previous_id??null,question_id:request.question_id??null,automatic:request.automatic??false,change_group:request.change_group??false};
+ return createHash('sha256').update(canonicalJSON(payload)).digest('hex');
+}
+async function activeBinding(client:Client,scope:ExplorationScope):Promise<string>{
+ const bindings=(await client.query("SELECT id FROM conversation_binding WHERE owner_id=$1 AND contact_id=$2 AND status='active' FOR SHARE",[scope.owner_id,scope.contact_id])).rows;
+ if(bindings.length>1)stale();if(bindings.length===1)return bindings[0].id;
+ const manual=(await client.query('SELECT id FROM manual_contact_confirmation WHERE owner_id=$1 AND contact_id=$2 FOR SHARE',[scope.owner_id,scope.contact_id])).rows;if(manual.length!==1)stale();return manual[0].id;
+}
+export class PostgresExplorationStore {
+ private readonly options:ExplorationStoreOptions;private readonly guards:ExplorationStoreGuards;private readonly assistant:ReturnType<typeof createReplyAssistantGuards>;
+ constructor(options:ExplorationStoreOptions){this.options=options;this.guards={active_binding:activeBinding,require_current_input:(...args)=>this.currentInput(...args),record_discussion_input:(...args)=>this.recordInput(...args),require_skill:async(client,scope,revision,id)=>{if(Number((await client.query('SELECT revision FROM skill_library WHERE owner_id=$1',[scope.owner_id])).rows[0]?.revision??0)!==revision)stale();if(id!==null)throw new ExplorationError('exploration_skill_guard_unavailable');},...options.guards};this.assistant=createReplyAssistantGuards(createReplySkillGuards({files:new SkillFiles(options.skills_root)}),(c,s)=>this.guards.active_binding(c,s));}
+ private async tx<T>(scope:ExplorationScope,fn:(client:Client)=>Promise<T>):Promise<T>{
+  if(!isUUID(scope.owner_id)||!isUUID(scope.contact_id))stale();
+  try{return await this.options.transaction(async c=>{await c.query('SELECT pg_advisory_xact_lock(hashtextextended($1,0))',[`owner:${scope.owner_id}`]);return fn(c);});}
+  catch(error){if(error instanceof ExplorationExpired){await this.prune_expired(scope);stale();}if(error instanceof ExplorationError)throw error;throw new ExplorationError('exploration_unavailable');}
