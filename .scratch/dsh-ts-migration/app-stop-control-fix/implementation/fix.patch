+async function within(promise, label) {
+  let timer;
+  try { return await Promise.race([promise, new Promise((_, reject) => {
+    timer = setTimeout(() => reject(new Error(label)), 10_000);
+  })]); } finally { clearTimeout(timer); }
+}
