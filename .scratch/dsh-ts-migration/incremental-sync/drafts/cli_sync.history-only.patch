+    def history_only_pending(self) -> bool:
+        """只查绑定、授权和历史状态；不读 CLI、不写任务或水位。"""
+
+        if not self._history_only:
+            raise ValueError("仅移交历史执行者提供此元数据入口。")
+        if not isinstance(self._history_authorization, RemoteHistoryAuthorization):
+            return False
+        allowed = self._remote_history_binding_ids()
+        if allowed is None:
+            # 给下一次历史片报告授权失败；不能因此改读未授权正文。
+            return True
+        if self._history_state is None:
+            return bool(allowed)
+        for binding in self._active_bindings():
+            if binding.binding_id not in allowed:
+                continue
+            state = self._history_state.read(
+                owner_id=self._owner_id, contact_id=binding.scope.contact_id,
+                binding_id=binding.binding_id,
+            )
+            if state is None or state.phase is not HistorySyncPhase.COMPLETE:
+                return True
+        return False
+
+    def current_history_coverages(self) -> tuple[HistoryCoverage, ...]:
+        """返回本地历史覆盖快照，不执行读页或自动发现。"""
+        return self._history_coverages(self._active_bindings())
+
+    def _cycle_history_only(
+        self, *, enabled: bool, priority_contact_id: UUID | None,
+        max_bindings: int | None, priority_requested_at: float | None,
+        cli_deadline: float | None,
+    ) -> CliSyncCycleResult:
+        """迁移期间只执行获准历史页；增量流、水位和缺口状态由 TS 管理。"""
+
+        self._close_stream()
+        self._failure_code = None
+        if not enabled:
+            self.close()
+        try:
+            bindings = self._active_bindings()
+        except ConversationBindingPersistenceError:
+            bindings = ()
+            self._failure_code = "binding_list_unavailable"
+        self._last_bound_count = len(bindings)
+        written = 0
+        eligible = ()
+        if enabled and bindings:
+            # history_only 不能通过旧账号级授权或缺失端口扩大读取范围。
+            if not isinstance(self._history_authorization, RemoteHistoryAuthorization):
+                self._failure_code = "history_authorization_required"
+            elif self._history_state is None:
+                self._failure_code = "history_state_unavailable"
+            else:
+                allowed = self._remote_history_binding_ids()
+                if allowed is not None:
+                    authorized = tuple(b for b in bindings if b.binding_id in allowed)
+                    self.start_history_for_bindings(authorized)
+                    candidates = []
+                    for binding in authorized:
+                        try:
+                            state = self._history_state.read(
+                                owner_id=self._owner_id, contact_id=binding.scope.contact_id,
+                                binding_id=binding.binding_id,
+                            )
+                        except HistorySyncStatePersistenceError:
+                            self._failure_code = "history_state_unavailable"
+                            continue
+                        if state is not None and state.phase is not HistorySyncPhase.COMPLETE:
+                            candidates.append(binding)
+                    eligible = tuple(candidates)
+        by_locator = {b.conversation_locator: b for b in eligible}
+        # 清除撤销、授权移除及已完成页的旧排队；每轮重新核验。
+        self._pending_locators = deque(x for x in self._pending_locators if x in by_locator)
+        self._pending_locator_set = set(self._pending_locators)
+        self._live_pending_locators.clear()
+        for binding in eligible:
+            self._enqueue(binding.conversation_locator)
+        priority = self._priority_binding(eligible, priority_contact_id)
+        self._set_priority_timing(
+            None if priority is None else priority.scope.contact_id, priority_requested_at,
+        )
+        self._prioritize_pending(priority_contact_id, eligible)
+        budget = _MAX_BINDINGS_PER_CYCLE if max_bindings is None else max_bindings
+        # 固定本轮快照：续页留给下一次宿主心跳，不在一轮读完历史。
+        for _ in range(min(budget, len(self._pending_locators))):
+            locator = self._pending_locators.popleft()
+            self._pending_locator_set.discard(locator)
+            self._live_pending_locators.discard(locator)
+            binding = by_locator[locator]
+            started = self._monotonic_clock()
+            deadline = started + self._cli_timeout_seconds
+            if cli_deadline is not None:
+                deadline = min(deadline, cli_deadline)
+            try:
+                count, _ = self._read_binding(
+                    binding, disabled_window=None, backfill_trigger_at=None,
+                    live_read=False, cli_deadline=deadline,
+                )
+                written += count
+            except CliNormalizationError:
+                self._failure_code = "cli_normalization_failed"
+            except CliAdapterError as error:
+                self._failure_code = error.code
+            except ObservationPersistenceError:
+                self._failure_code = "observation_persistence_failed"
+            except SourceProcessingWriteError:
+                self._failure_code = "source_processing_write_failed"
+            except HistorySyncStatePersistenceError:
+                self._failure_code = "history_state_unavailable"
+        coverages = self._history_coverages(bindings)
+        phase = (CliSyncPhase.DISABLED if not enabled else
+                 CliSyncPhase.DEGRADED if self._failure_code else
+                 CliSyncPhase.ACTIVE if bindings else CliSyncPhase.WAITING_BINDINGS)
+        return CliSyncCycleResult(
+            status=CliSyncStatus(
+                phase=phase, stream_active=False, stream_mode=None,
+                failure_code=self._failure_code, bound_count=len(bindings),
+                pending_count=len(self._pending_locators), history_coverages=coverages,
+                **self._priority_status_fields(),
+            ),
+            batch_message_count=written,
+            cli_available=None if self._last_cli_result is None else self._last_cli_result[0],
+            cli_failure_code=None if self._last_cli_result is None else self._last_cli_result[1],
+        )
+
