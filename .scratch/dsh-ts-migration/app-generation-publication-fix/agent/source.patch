+  ...(turn.basis_changes===undefined?{}:{basis_changes:turn.basis_changes}),
+  ...(turn.continuation===undefined?{}:{continuation:turn.continuation,effective_input:turn.effective_input,effective_scene:turn.effective_scene}),
