+  const owner=await f.store.ownerProgress(f.scope.ownerId);
+  assert.equal(owner.scope,'owner');assert.equal(owner.contact_id,null);
+  assert.deepEqual(new Set(owner.tasks.map(task=>task.task_id)),new Set([first,second]));
