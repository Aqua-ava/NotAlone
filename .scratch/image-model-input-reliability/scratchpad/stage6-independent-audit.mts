/** 独立验收只读副本；原图身份与调用标识仅留私有结果，输出只保留安全计数。 */
import {readFile,writeFile,lstat,rm} from 'node:fs/promises';
import {DatabaseSync} from 'node:sqlite';
import {join} from 'node:path';
import {runTargetsReleased} from '../../../backend-ts/src/memory/sqlite/run-retirement.ts';
const privateRoot='/tmp/notalone-image-reliability-hw9x92j_',copy=process.argv[2],label=process.argv[3]??'initial';
if(!/^[a-z0-9-]{1,32}$/.test(label))throw Error('audit_label_invalid');
const stat=await lstat(copy);if(!stat.isDirectory()||stat.uid!==process.getuid?.()||(stat.mode&0o077)!==0||!copy.startsWith(privateRoot+'/schedule-probe-'))throw Error('audit_copy_invalid');
const scope=JSON.parse(await readFile(join(privateRoot,'stage6-scope.json'),'utf8')),authorization=JSON.parse(await readFile(join(privateRoot,'stage6-authorized.json'),'utf8')),since=Number(authorization.start)*1000;
if(!Number.isFinite(since)||authorization.limit!==96)throw Error('audit_authorization_invalid');
const db=new DatabaseSync(join(copy,'snapshot.sqlite'),{readOnly:true});
const read=(sql:string,params:any[]=[])=>{const s=db.prepare(sql);s.setReadBigInts(true);return s.all(...params);},get=(sql:string,p:any[]=[])=>read(sql,p)[0];
const count=(sql:string,p:any[]=[])=>Number(get(sql,p)?.n??0),group=(rows:any[],key:string)=>Object.fromEntries([...new Set(rows.map(row=>String(row[key])))].map(value=>[value,rows.filter(row=>String(row[key])===value).length]));
const plain=(value:any):any=>typeof value==='bigint'?value.toString():Array.isArray(value)?value.map(plain):value&&typeof value==='object'?Object.fromEntries(Object.entries(value).map(([key,item])=>[key,plain(item)])):value;
try{
 const files=read("SELECT f.id,f.content_digest,f.byte_size,p.extraction_state FROM media_file f LEFT JOIN processing_item p ON p.owner_id=f.owner_id AND p.contact_id=f.contact_id AND p.message_id=f.message_id AND p.purpose='memory_extraction' WHERE f.owner_id=? AND f.contact_id=? AND f.role='image_display' AND f.content_state='present' AND f.publish_state='current' AND f.container_valid=1 AND f.viewable=1",[scope.ownerId,scope.contactId]);
 const sent=read(`SELECT json_extract(img.value,'$.id') AS id,json_extract(img.value,'$.sourceSha256') AS source_sha256,json_extract(img.value,'$.originalBytes') AS original_bytes,
 json_extract(img.value,'$.bytes') AS sent_bytes,json_extract(img.value,'$.width') AS width,json_extract(img.value,'$.height') AS height,json_extract(img.value,'$.requestMimeType') AS format,
 c.id AS call_id,c.state,c.settlement_state FROM execution_event e JOIN model_call c ON c.owner_id=e.owner_id AND c.id=e.originated_call_id JOIN json_each(e.payload,'$.images') img
 WHERE e.owner_id=? AND e.kind='image_inputs' AND c.sent_at>=? AND EXISTS(SELECT 1 FROM operation_scope x WHERE x.owner_id=c.owner_id AND x.operation_id=c.operation_id AND x.source_contact_id=?)`,[scope.ownerId,since,scope.contactId]);
 const images=files.map(file=>{const versions=sent.filter(row=>row.id===file.id),known=versions.filter(row=>row.state==='succeeded'&&row.settlement_state==='settled'&&row.source_sha256===file.content_digest&&row.original_bytes===file.byte_size);return {fileId:file.id,succeeded:file.extraction_state==='succeeded',knownImageCalls:known.length,shaMismatch:versions.some(row=>row.source_sha256!==file.content_digest),originalByteMismatch:versions.some(row=>row.original_bytes!==file.byte_size),versions};});
 const newCalls=`SELECT c.* FROM model_call c LEFT JOIN step_attempt a ON a.owner_id=c.owner_id AND a.id=c.step_attempt_id WHERE c.sent_at>=? OR c.sent_at IS NULL AND a.started_at>=?`;
 const calls=read(`WITH new_calls AS (${newCalls}) SELECT c.id,c.state,c.settlement_state,o.purpose FROM new_calls c JOIN model_operation o ON o.owner_id=c.owner_id AND o.id=c.operation_id`,[since,since]);
 const scopeCalls=count(`WITH new_calls AS (${newCalls}) SELECT count(DISTINCT c.id) AS n FROM new_calls c JOIN operation_scope x ON x.owner_id=c.owner_id AND x.operation_id=c.operation_id WHERE x.owner_id<>? OR x.source_contact_id<>?`,[since,since,scope.ownerId,scope.contactId]);
 const unprovenCalls=count(`WITH new_calls AS (${newCalls}) SELECT count(*) AS n FROM new_calls c WHERE NOT EXISTS(SELECT 1 FROM operation_scope x WHERE x.owner_id=c.owner_id AND x.operation_id=c.operation_id AND x.owner_id=? AND x.source_contact_id=?)`,[since,since,scope.ownerId,scope.contactId]);
 const foreignInputs=count('SELECT count(*) AS n FROM run_input x JOIN processing_run r ON r.owner_id=x.owner_id AND r.id=x.run_id WHERE r.started_at>=? AND (x.owner_id<>? OR x.source_contact_id<>?)',[since,scope.ownerId,scope.contactId]);
 const foreignContacts=count('SELECT count(*) AS n FROM run_contact x JOIN processing_run r ON r.owner_id=x.owner_id AND r.id=x.run_id WHERE r.started_at>=? AND (x.owner_id<>? OR x.contact_id<>?)',[since,scope.ownerId,scope.contactId]);
 const foreignContributions=count('SELECT count(*) AS n FROM task_contribution x JOIN processing_run r ON r.owner_id=x.owner_id AND r.id=x.run_id WHERE r.started_at>=? AND (x.owner_id<>? OR x.source_contact_id<>?)',[since,scope.ownerId,scope.contactId]);
 const unknown=count("SELECT count(*) AS n FROM model_call WHERE state='unknown' OR settlement_state='unknown'");
 const sampleUnknown=count("SELECT count(DISTINCT c.id) AS n FROM model_call c JOIN operation_scope x ON x.owner_id=c.owner_id AND x.operation_id=c.operation_id WHERE x.owner_id=? AND x.source_contact_id=? AND (c.state='unknown' OR c.settlement_state='unknown')",[scope.ownerId,scope.contactId]);
 const residuals=['d8b8510d','c296e552'].map(prefix=>{const row=get('SELECT id,state FROM processing_run WHERE owner_id=? AND id LIKE ?',[scope.ownerId,prefix+'%']);return {label:prefix==='d8b8510d'?'legacy_failed':'legacy_stale',state:row?.state??'absent',targetsReleased:row?runTargetsReleased({get,all:read,run(){throw Error('audit_write_forbidden');}} as any,scope.ownerId,String(row.id)):false};});
 const later=read('SELECT stage,state FROM memory_document_later_schedule WHERE owner_id=? AND scope_kind=\'contact\' AND contact_id=?',[scope.ownerId,scope.contactId]);
 const failures=[];if(images.length!==14||images.some(row=>!row.succeeded||row.knownImageCalls<1||row.shaMismatch||row.originalByteMismatch))failures.push('image_coverage_unproven');if(scopeCalls||unprovenCalls||foreignInputs||foreignContacts||foreignContributions)failures.push('foreign_scope_violation');if(sampleUnknown||unknown-sampleUnknown!==4)failures.push('unknown_receipt_changed');
 const safe={label,observedAt:new Date().toISOString(),automatic:get('SELECT memory_auto_processing FROM database_instance WHERE slot=1').memory_auto_processing===1n,imageCounts:{saved:images.length,succeeded:images.filter(row=>row.succeeded).length,knownModelInput:images.filter(row=>row.knownImageCalls>0).length,sourceShaMatches:images.filter(row=>!row.shaMismatch&&row.knownImageCalls>0).length,originalBytesMatch:images.filter(row=>!row.originalByteMismatch&&row.knownImageCalls>0).length,minKnownImageCalls:Math.min(...images.map(row=>row.knownImageCalls))},sentVersions:sent.length,maxSentBytes:Math.max(0,...sent.map(row=>Number(row.sent_bytes))),sentFormats:group(sent,'format'),newCalls:calls.length,callStates:group(calls,'state'),settlements:group(calls,'settlement_state'),callPurposes:group(calls,'purpose'),foreignCallSources:scopeCalls,unprovenCalls,foreignInputs,foreignContacts,foreignContributions,sampleUnknown,otherUnknown:unknown-sampleUnknown,residuals,laterStages:later.map(row=>({stage:row.stage,state:row.state})),failures,passed:failures.length===0};
 await writeFile(join(privateRoot,`stage6-independent-${label}.json`),JSON.stringify(plain({safe,images,calls}),null,2)+'\n',{mode:0o600});console.log(JSON.stringify(safe));
}finally{db.close();await rm(copy,{recursive:true,force:true});}
